    "e2e:install": "playwright install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:check": "biome check .",
    "check": "pnpm lint:check && pnpm typecheck && pnpm test && pnpm build",
    "verify:upgrade": "pnpm check && pnpm e2e && pnpm e2e:production",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "auth:schema:generate": "pnpm dlx @better-auth/cli@latest generate --yes --output src/db/auth.schema.ts",
