  "name": "photoscraft",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "next experimental-analyze",
    "start": "next start",
    "e2e": "playwright test",
    "e2e:production": "playwright test --config playwright.production.config.ts",
    "e2e:stripe": "tsx scripts/run-stripe-e2e.ts",
    "e2e:creem": "tsx scripts/run-creem-e2e.ts",
    "e2e:waffo": "tsx scripts/run-waffo-e2e.ts",
