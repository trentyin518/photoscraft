        "item-3": { "name": "Yucel Faruksahan", "role": "Tailkits Creator", "image": "https://randomuser.me/api/portraits/men/7.jpg", "quote": "PhotoCraft 템플릿 작업이 훌륭합니다. 본 최고의 개인 사이트 중 하나예요." },
        "item-4": { "name": "Anonymous author", "role": "Product Manager", "image": "https://randomuser.me/api/portraits/men/8.jpg", "quote": "PhotoCraft 템플릿은 처음부터 이해하기 쉽고 코드·블록을 목적에 맞게 고치기 좋습니다." },
        "item-5": { "name": "Shekinah Tshiokufila", "role": "Senior Software Engineer", "image": "https://randomuser.me/api/portraits/men/4.jpg", "quote": "PhotoCraft는 웹디자인의 기준을 새로 쓰고 있습니다. 아름다움을 좋아하지만 시간이 없는 분께 쉽고 효율적인 방법을 줍니다." },
        "item-6": { "name": "Oketa Fred", "role": "Fullstack Developer", "image": "https://randomuser.me/api/portraits/men/2.jpg", "quote": "PhotoCraft가 너무 좋아요! 컴포넌트 블록이 아름답고 쓰기 쉬워 멋진 사이트 만들기가 식은 죽 먹기입니다." },
        "item-7": { "name": "Zeki", "role": "Founder of ChatExtend", "image": "https://randomuser.me/api/portraits/men/5.jpg", "quote": "PhotoCraft는 단순함과 활용도의 완벽한 조합으로 아름답고 쓰기 편한 UI를 만들게 해줍니다." },
        "item-8": { "name": "Joseph Kitheka", "role": "Fullstack Developer", "image": "https://randomuser.me/api/portraits/men/9.jpg", "quote": "PhotoCraft는 웹앱 개발 방식을 바꿨습니다. 방대한 UI 컴포넌트·블록·템플릿 덕분에 작업이 훨씬 빨라졌습니다." },
        "item-9": { "name": "Khatab Wedaa", "role": "MerakiUI Creator", "image": "https://randomuser.me/api/portraits/men/10.jpg", "quote": "PhotoCraft는 우아하고 깨끗하며 반응형인 Tailwind CSS 컴포넌트로 빠르게 시작하기 좋습니다." },
